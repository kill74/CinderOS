def default_page_from_args(argv):
    if "--page" in argv:
        index = argv.index("--page")
        if index + 1 < len(argv):
            return argv[index + 1]
    return "welcome"


if __name__ == "__main__":
    app = CinderControl(default_page_from_args(sys.argv))
    app.run([sys.argv[0]])
