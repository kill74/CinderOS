def install_css():
    display = Gdk.Display.get_default()
    if display is None:
        return

    provider = Gtk.CssProvider()
    provider.load_from_data(STYLE_CSS.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def command_exists(name):
    return shutil.which(name) is not None


def is_live_session():
    return os.path.isdir("/run/archiso") or command_exists("cinder-install")


def command_output(args, fallback="Unknown", timeout=2):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return fallback

    output = result.stdout.strip()
    if output:
        return output.splitlines()[0].strip()
    return fallback


def command_text(args, fallback="", timeout=2):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return fallback

    output = result.stdout.strip()
    return output or fallback


def service_state(unit):
    return command_output(["systemctl", "is-active", unit], "unknown")


def session_mode():
    if command_exists("cinder-session-mode"):
        return command_output(["cinder-session-mode", "--plain"], "cosmic")

    try:
        with open("/etc/cinderos/session-mode", "r", encoding="utf-8") as handle:
            return handle.read().strip() or "cosmic"
    except OSError:
        return "cosmic"


def memory_profile_summary():
    earlyoom = service_state("earlyoom.service")
    heavy_services = {
        "Docker": "docker.service",
        "Printing": "cups.service",
        "Bluetooth": "bluetooth.service",
        "fwupd": "fwupd.service",
    }
    active_heavy = [name for name, unit in heavy_services.items() if service_state(unit) == "active"]

    if earlyoom == "active" and not active_heavy:
        return "Low-idle"
    if active_heavy:
        return "Custom: " + ", ".join(active_heavy)
    if earlyoom in ("inactive", "failed"):
        return "Not applied"
    return "Unknown"


def snapshots_summary():
    if os.path.exists("/etc/snapper/configs/root"):
        return "Configured"
    return "Not configured"


def firewall_summary():
    return service_state("ufw.service")


def apparmor_summary():
    return service_state("apparmor.service")


def root_filesystem_summary():
    fstype = command_output(["findmnt", "-no", "FSTYPE", "/"], "unknown")
    source = command_output(["findmnt", "-no", "SOURCE", "/"], "")
    if source:
        return f"{fstype} on {source}"
    return fstype


def root_usage_info():
    output = command_text(["df", "-hP", "/"], "", timeout=2)
    lines = output.splitlines()
    if len(lines) < 2:
        return "unknown", "warning"

    fields = lines[1].split()
    if len(fields) < 5:
        return "unknown", "warning"

    used_percent = fields[4]
    try:
        used_value = int(used_percent.rstrip("%"))
    except ValueError:
        return f"{used_percent} used", "neutral"

    if used_value >= 90:
        kind = "error"
    elif used_value >= 80:
        kind = "warning"
    else:
        kind = "good"

    available = fields[3] if len(fields) > 3 else "unknown"
    return f"{used_percent} used, {available} free", kind


def kernel_summary():
    return command_output(["uname", "-r"], "unknown")


def zram_summary():
    swaps = command_text(["swapon", "--show=NAME"], "", timeout=2).lower()
    if "zram" in swaps:
        return "Active"
    return "Inactive"


def ready_kind(state):
    if state in ("Installed", "Ready", "Running", "Detected", "Configured", "active"):
        return "good"
    if state in ("Missing", "Inactive", "inactive", "failed", "Not found", "Not configured"):
        return "warning"
    return "neutral"


def tool_summary(command):
    if command_exists(command):
        return "Installed"
    return "Missing"


def package_installed(package):
    if not command_exists("pacman"):
        return False

    try:
        result = subprocess.run(["pacman", "-Q", package], capture_output=True, text=True, timeout=2, check=False)
    except (OSError, subprocess.SubprocessError):
        return False

    return result.returncode == 0


def package_summary(package):
    if package_installed(package):
        return "Installed"
    return "Missing"


def group_summary(group):
    user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if not user:
        return "Unknown"

    try:
        result = subprocess.run(["id", "-nG", user], capture_output=True, text=True, timeout=2, check=False)
    except (OSError, subprocess.SubprocessError):
        return "Unknown"

    groups = result.stdout.split()
    if group in groups:
        return "Ready"
    return "Missing"


def proton_ge_summary():
    paths = [
        os.path.expanduser("~/.steam/root/compatibilitytools.d/GE-Proton*"),
        os.path.expanduser("~/.steam/steam/compatibilitytools.d/GE-Proton*"),
        os.path.expanduser("~/.local/share/Steam/compatibilitytools.d/GE-Proton*"),
    ]
    if any(glob.glob(path) for path in paths):
        return "Installed"
    return "Missing"


def controller_summary():
    if glob.glob("/dev/input/js*"):
        return "Detected"
    return "Not found"


def project_folder_summary():
    path = os.environ.get("CINDEROS_PROJECTS_DIR") or os.path.expanduser("~/Projects")
    if os.path.isdir(path):
        return "Ready"
    return "Missing"


def command_primary(command):
    first_command = command.split(";", 1)[0].strip()
    if not first_command:
        return None

    try:
        parts = shlex.split(first_command)
    except ValueError:
        parts = first_command.split()

    while parts and parts[0] in ("sudo", "doas", "env"):
        parts = parts[1:]

    while parts and "=" in parts[0] and not parts[0].startswith("/"):
        parts = parts[1:]

    if not parts:
        return None

    return os.path.basename(parts[0])


def command_available(command):
    primary = command_primary(command)
    if primary is None:
        return True
    return command_exists(primary)


def run_detached(args):
    subprocess.Popen(args, start_new_session=True)


def run_in_terminal(command):
    trailer = "echo; read -r -p 'Press Enter to close...' _"
    shell_command = f"{command}; status=$?; {trailer}; exit $status"

    if command_exists("kitty"):
        run_detached(["kitty", "-e", "bash", "-lc", shell_command])
        return

    if command_exists("cosmic-term"):
        run_detached(["cosmic-term", "--command", "bash", "-lc", shell_command])
        return

    run_detached(["bash", "-lc", shell_command])


def run_desktop(command):
    subprocess.Popen(["bash", "-lc", command], start_new_session=True)


class CinderControl(Adw.Application):
    def __init__(self, default_page="welcome"):
        super().__init__(application_id=APP_ID)
        self.default_page = default_page
        self.stack = None
        self.nav_box = None
        self.page_title = None
        self.page_subtitle = None
        self.page_index = {}
        self.nav_buttons = {}

    def do_activate(self):
        install_css()

        win = Adw.ApplicationWindow(application=self)
        win.set_title("CinderOS Settings")
        win.set_default_size(1080, 720)
        win.add_css_class("cinder-window")

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        title = Gtk.Label()
        title.set_markup("<b>CinderOS Settings</b>")
        header.set_title_widget(title)
        toolbar.add_top_bar(header)

        shell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        shell.add_css_class("cinder-shell")

        sidebar = self.build_sidebar()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        content.add_css_class("cinder-content")
        content.set_hexpand(True)
        content.set_vexpand(True)

        page_header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page_header.add_css_class("cinder-page-header")
        self.page_title = Gtk.Label()
        self.page_title.set_xalign(0)
        self.page_title.add_css_class("cinder-page-title")
        self.page_subtitle = Gtk.Label()
        self.page_subtitle.set_xalign(0)
        self.page_subtitle.add_css_class("cinder-page-subtitle")
        page_header.append(self.page_title)
        page_header.append(self.page_subtitle)

        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)

        content.append(page_header)
        content.append(self.stack)
        shell.append(sidebar)
        shell.append(content)
        toolbar.set_content(shell)

        self.add_page("welcome", "Start", self.welcome_page())
        self.add_page("status", "Status", self.status_page())
        self.add_page("installer", "Installer", self.installer_page())
        self.add_page("system", "System", self.system_page())
        self.add_page("dev", "Dev", self.dev_page())
        self.add_alias("development", "dev")
        self.add_alias("programming", "dev")
        self.add_page("appearance", "Appearance", self.appearance_page())
        self.add_alias("rice", "appearance")
        self.add_page("memory", "Memory", self.memory_page())
        self.add_page("services", "Services", self.services_page())
        self.add_page("security", "Security", self.security_page())
        self.add_page("session", "Session", self.session_page())
        self.add_page("gaming", "Games", self.gaming_page())
        self.add_alias("games", "gaming")
        self.add_page("snapshots", "Backups", self.snapshots_page())
        self.add_alias("backups", "snapshots")
        self.add_page("diagnostics", "Diagnostics", self.diagnostics_page())
        self.add_alias("doctor", "diagnostics")
        self.add_page("about", "About", self.about_page())

        self.open_page(self.default_page if self.default_page in self.page_index else "welcome")

        win.set_content(toolbar)
        win.present()

    def build_sidebar(self):
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sidebar.set_size_request(230, -1)
        sidebar.add_css_class("cinder-sidebar")

        title = Gtk.Label(label="CinderOS")
        title.set_xalign(0)
        title.add_css_class("cinder-sidebar-title")
        subtitle = Gtk.Label(label="Settings and checks")
        subtitle.set_xalign(0)
        subtitle.add_css_class("cinder-sidebar-subtitle")

        self.nav_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.nav_box.set_vexpand(True)

        sidebar.append(title)
        sidebar.append(subtitle)
        sidebar.append(self.nav_box)
        return sidebar

    def add_page(self, name, title, page):
        page.set_hexpand(True)
        page.set_vexpand(True)
        self.stack.add_named(page, name)
        self.page_index[name] = name
        self.add_sidebar_button(name, title)

    def add_alias(self, alias, target):
        if target in self.page_index:
            self.page_index[alias] = self.page_index[target]

    def add_sidebar_button(self, name, title):
        meta = PAGE_META.get(name, (title, "", "application-x-executable-symbolic"))
        button = Gtk.ToggleButton()
        button.add_css_class("cinder-nav-button")
        button.set_hexpand(True)
        button.set_halign(Gtk.Align.FILL)
        button.set_tooltip_text(meta[1])

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        icon = Gtk.Image.new_from_icon_name(meta[2])
        icon.set_pixel_size(16)
        label = Gtk.Label(label=title)
        label.set_xalign(0)
        label.set_hexpand(True)
        row.append(icon)
        row.append(label)
        button.set_child(row)
        button.connect("clicked", lambda _button, page_name=name: self.open_page(page_name))

        self.nav_buttons[name] = button
        self.nav_box.append(button)

    def preferences_page(self):
        page = Adw.PreferencesPage()
        page.set_margin_top(18)
        page.set_margin_bottom(18)
        page.set_margin_start(18)
        page.set_margin_end(18)
        return page

    def add_group(self, page, title, description=None):
        group = Adw.PreferencesGroup()
        group.set_title(title)
        if description:
            group.set_description(description)
        page.add(group)
        return group

    def open_page(self, name):
        target = self.page_index.get(name)
        if not target:
            return

        self.stack.set_visible_child_name(target)
        self.update_page_header(target)
        for page_name, button in self.nav_buttons.items():
            button.set_active(page_name == target)

    def update_page_header(self, name):
        title, subtitle, _icon = PAGE_META.get(name, (name.title(), "", ""))
        self.page_title.set_label(title)
        self.page_subtitle.set_label(subtitle)

    def badge(self, text, kind="neutral"):
        label = Gtk.Label(label=text)
        label.set_xalign(1)
        label.add_css_class("caption")
        label.add_css_class("cinder-badge")
        if kind == "good":
            label.add_css_class("success")
        elif kind == "warning":
            label.add_css_class("warning")
        elif kind == "error":
            label.add_css_class("error")
        else:
            label.add_css_class("dim-label")
        return label

    def add_row_icon(self, row, title):
        icon_name = ROW_ICONS.get(title)
        if not icon_name:
            return

        icon = Gtk.Image.new_from_icon_name(icon_name)
        icon.set_pixel_size(16)
        icon.add_css_class("dim-label")
        row.add_prefix(icon)

    def kind_for_service(self, state):
        state = state.lower()
        if state == "active":
            return "good"
        if state == "failed":
            return "error"
        if state in ("inactive", "unknown"):
            return "warning"
        return "neutral"

    def kind_for_memory(self, summary):
        if summary == "Low-idle":
            return "good"
        if summary == "Not applied":
            return "warning"
        return "neutral"

    def add_status(self, group, title, subtitle, status, kind="neutral"):
        row = Adw.ActionRow()
        row.set_title(title)
        row.set_subtitle(subtitle)
        self.add_row_icon(row, title)
        row.add_suffix(self.badge(status, kind))
        group.add(row)

    def add_action(self, group, title, subtitle, label, command, terminal=True, suggested=False):
        row = Adw.ActionRow()
        row.set_title(title)
        self.add_row_icon(row, title)
        button = Gtk.Button(label=label)
        button.set_valign(Gtk.Align.CENTER)
        button.set_size_request(96, -1)
        button.add_css_class("cinder-action-button")

        required_command = command_primary(command)
        if required_command and not command_available(command):
            row.set_subtitle(f"{subtitle} Requires: {required_command}.")
            button.set_label("Missing")
            button.set_sensitive(False)
            button.set_tooltip_text(f"Command not found: {required_command}")
        else:
            row.set_subtitle(subtitle)
            button.set_tooltip_text(command)

        if suggested:
            button.add_css_class("suggested-action")
        button.connect("clicked", lambda _button: run_in_terminal(command) if terminal else run_desktop(command))
        row.add_suffix(button)
        row.set_activatable_widget(button)
        group.add(row)

    def add_nav(self, group, title, subtitle, label, page_name):
        row = Adw.ActionRow()
        row.set_title(title)
        row.set_subtitle(subtitle)
        self.add_row_icon(row, title)
        button = Gtk.Button(label=label)
        button.set_valign(Gtk.Align.CENTER)
        button.set_size_request(96, -1)
        button.add_css_class("cinder-action-button")
        button.connect("clicked", lambda _button: self.open_page(page_name))
        row.add_suffix(button)
        row.set_activatable_widget(button)
        group.add(row)

    def add_info(self, group, title, subtitle):
        row = Adw.ActionRow()
        row.set_title(title)
        row.set_subtitle(subtitle)
        self.add_row_icon(row, title)
        group.add(row)

    def add_service_control(self, group, title, subtitle, unit, enable_command, disable_command):
        state = service_state(unit)
        row = Adw.ActionRow()
        row.set_title(title)
        row.set_subtitle(subtitle)
        row.add_suffix(self.badge(state, self.kind_for_service(state)))

        enable = Gtk.Button(label="Enable")
        enable.set_valign(Gtk.Align.CENTER)
        enable.set_size_request(96, -1)
        enable.add_css_class("cinder-action-button")
        enable.set_tooltip_text(enable_command)
        enable.connect("clicked", lambda _button: run_in_terminal(enable_command))

        disable = Gtk.Button(label="Disable")
        disable.set_valign(Gtk.Align.CENTER)
        disable.set_size_request(96, -1)
        disable.add_css_class("cinder-action-button")
        disable.set_tooltip_text(disable_command)
        disable.connect("clicked", lambda _button: run_in_terminal(disable_command))

        if not command_available(enable_command):
            enable.set_sensitive(False)
        if not command_available(disable_command):
            disable.set_sensitive(False)

        row.add_suffix(enable)
        row.add_suffix(disable)
        row.set_activatable_widget(enable)
        group.add(row)

    def welcome_page(self):
        page = self.preferences_page()
        live = is_live_session()

        if live:
            group = self.add_group(page, "Start", "Install, or check the live session first.")
            self.add_action(group, "Install CinderOS", "Open the installer.", "Install", "cinder-install", terminal=False, suggested=True)
            self.add_action(group, "Hardware", "Check graphics hardware and session settings.", "Check", "sudo cinder-hardware-setup")
            self.add_action(group, "Mirrors", "Update the pacman mirror list.", "Update", "cinder-refresh-mirrors")
            self.add_nav(group, "Status", "See session, memory, security, and backup state.", "View", "status")
            self.add_info(group, "Live session", "Changes here are temporary until CinderOS is installed.")
        else:
            group = self.add_group(page, "Start", "A few things to check first.")
            self.add_action(group, "Appearance", "Apply the default wallpaper and user theme files.", "Apply", "cinder-rice apply", suggested=True)
            self.add_action(group, "Hardware", "Check graphics hardware and session settings.", "Check", "sudo cinder-hardware-setup")
            self.add_nav(group, "Status", "See session, memory, security, and backup state.", "View", "status")
            self.add_action(group, "Backups", "Set up Btrfs snapshots.", "Set up", "sudo cinder-snapshot setup")

        nav = self.add_group(page, "Pages")
        self.add_nav(nav, "Status", "Session, memory, security, and backups.", "Open", "status")
        self.add_nav(nav, "Dev", "Full-stack tools, Docker, databases, and projects.", "Open", "dev")
        self.add_nav(nav, "Appearance", "Wallpaper, terminal, shell, GTK, and boot theme.", "Open", "appearance")
        self.add_nav(nav, "Memory", "Zram, earlyoom, pressure, and memory modes.", "Open", "memory")
        self.add_nav(nav, "Security", "Firewall, AppArmor, SSH, USBGuard, scans, and Secure Boot.", "Open", "security")
        self.add_nav(nav, "Games", "Steam, Proton, overlays, controllers, and checks.", "Open", "gaming")
        self.add_nav(nav, "Backups", "Snapper, manual snapshots, and Btrfs Assistant.", "Open", "snapshots")
        self.add_nav(nav, "Session", "Default login session.", "Open", "session")
        self.add_nav(nav, "Diagnostics", "Checks, logs, hardware, and saved reports.", "Open", "diagnostics")

        guide = self.add_group(page, "Reference")
        self.add_action(guide, "Commands", "Show the full command list.", "Open", "cinder-welcome commands")
        return page

    def status_page(self):
        page = self.preferences_page()
        live = is_live_session()
        memory_summary = memory_profile_summary()
        firewall = firewall_summary()
        apparmor = apparmor_summary()
        backups = snapshots_summary()
        root_usage, root_usage_kind = root_usage_info()
        zram = zram_summary()

        group = self.add_group(page, "This Boot", "The few things I check first.")
        self.add_status(
            group,
            "Mode",
            "Live sessions are temporary; installed systems keep these changes.",
            "Live session" if live else "Installed system",
            "warning" if live else "good",
        )
        self.add_status(group, "Session", "Default login session.", session_mode(), "neutral")
        self.add_status(group, "Memory mode", "Low-idle is the normal desktop mode.", memory_summary, self.kind_for_memory(memory_summary))
        self.add_status(group, "Firewall", "UFW should be running.", firewall, self.kind_for_service(firewall))
        self.add_status(group, "AppArmor", "AppArmor should be running after boot.", apparmor, self.kind_for_service(apparmor))
        self.add_status(group, "Backups", "Snapper is off until you set it up.", backups, "good" if backups == "Configured" else "warning")

        system = self.add_group(page, "System", "Kernel, disk, and rollback checks.")
        root_fs = root_filesystem_summary()
        self.add_status(system, "Kernel", "Kernel in use for this boot.", kernel_summary(), "neutral")
        self.add_status(system, "Root filesystem", "Rollback works best on Btrfs.", root_fs, "good" if root_fs.startswith("btrfs") else "warning")
        self.add_status(system, "Root space", "Keep enough free space for updates and snapshots.", root_usage, root_usage_kind)
        self.add_status(system, "Zram", "Compressed swap for the desktop.", zram, "good" if zram == "Active" else "warning")

        actions = self.add_group(page, "Checks")
        self.add_action(actions, "System check", "Check boot, rollback, services, graphics, and updates.", "Run", "cinder-doctor")
        self.add_action(actions, "Update system", "Update; Snapper adds a pre-update snapshot when it is set up.", "Update", "sudo cinder-update")
        self.add_action(actions, "Memory details", "Open the full memory report.", "Open", "cinder-memory status")
        self.add_action(actions, "Security details", "Open the full security report.", "Open", "cinder-security status")
        self.add_action(actions, "Backup details", "Show snapshot state.", "Open", "cinder-snapshot status")
        self.add_nav(actions, "Diagnostics", "Open logs, hardware checks, and saved reports.", "Open", "diagnostics")
        return page

