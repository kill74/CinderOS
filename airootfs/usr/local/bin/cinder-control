    def dev_page(self):
        page = self.preferences_page()

        tools = self.add_group(page, "Full-Stack Tools", "Runtimes, package managers, and local API tools.")
        for title, subtitle, command in (
            ("Node", "JavaScript runtime.", "node"),
            ("npm", "Node package manager.", "npm"),
            ("pnpm", "Fast Node package manager.", "pnpm"),
            ("Python", "Python runtime.", "python"),
            ("pip", "Python package installer.", "pip"),
            ("pipx", "Python app installer.", "pipx"),
            ("Poetry", "Python project manager.", "poetry"),
            ("Rustup", "Rust toolchain manager.", "rustup"),
            ("Go", "Go compiler and tools.", "go"),
            ("Java", "OpenJDK runtime.", "java"),
            ("Git", "Version control.", "git"),
            ("GitHub CLI", "GitHub command line client.", "gh"),
            ("direnv", "Project-local environment loading.", "direnv"),
            ("HTTPie", "Friendly HTTP client.", "http"),
            ("hurl", "HTTP test runner.", "hurl"),
        ):
            status = tool_summary(command)
            self.add_status(tools, title, subtitle, status, ready_kind(status))

        local = self.add_group(page, "Local Work", "Projects, Docker, and databases.")
        projects = project_folder_summary()
        self.add_status(local, "Open projects", "Default home for local code.", projects, ready_kind(projects))
        docker = tool_summary("docker")
        self.add_status(local, "Docker", "CLI package state.", docker, ready_kind(docker))
        docker_service = service_state("docker.service")
        self.add_status(local, "Docker service", "Only runs after you enable it.", docker_service, "good" if docker_service == "active" else "neutral")
        docker_group = group_summary("docker")
        self.add_status(local, "Docker group", "Needed for Docker without sudo.", docker_group, ready_kind(docker_group))
        postgres = service_state("postgresql.service")
        redis = service_state("redis.service")
        sqlite = tool_summary("sqlite3")
        self.add_status(local, "PostgreSQL", "Installed database service; left off by default.", postgres, "good" if postgres == "active" else "neutral")
        self.add_status(local, "Redis", "Installed cache service; left off by default.", redis, "good" if redis == "active" else "neutral")
        self.add_status(local, "SQLite", "Single-file database CLI.", sqlite, ready_kind(sqlite))

        actions = self.add_group(page, "Actions", "Setup stays local and services stay off unless you enable them.")
        self.add_action(actions, "What is installed", "Print runtimes, Docker, databases, editor, shell, and projects.", "Run", "cinder-dev status")
        self.add_action(actions, "Install dev tools", "Install the full-stack package set without enabling services.", "Install", "cinder-dev fullstack")
        self.add_action(actions, "Docker setup", "Enable Docker and add your user to the docker group.", "Enable", "cinder-dev docker")
        self.add_action(actions, "Check databases", "Show PostgreSQL, Redis, and SQLite status.", "Show", "cinder-dev db")
        self.add_action(actions, "Open projects", "Open your project folder.", "Open", 'mkdir -p "$HOME/Projects"; xdg-open "$HOME/Projects"', terminal=False)

        personal = self.add_group(page, "My Setup", "Local dotfile backups. Secrets stay out.")
        self.add_action(personal, "Save my setup", "Copy selected dotfiles and CinderOS settings into a local backup.", "Save", "cinder-personal save")
        self.add_action(personal, "Restore my setup", "Restore selected dotfiles from the latest local backup.", "Restore", "cinder-personal restore")
        self.add_action(personal, "List personal backups", "Show local backups.", "List", "cinder-personal list")
        return page

