#!/usr/bin/env bash
set -euo pipefail

APPS_DIR="/usr/share/applications"
LOCAL_APPS_DIR="$HOME/.local/share/applications"

mkdir -p "$LOCAL_APPS_DIR"

APP=$(find "$APPS_DIR" -maxdepth 1 -name "*.desktop" -exec basename {} \; | fzf --prompt="Select App to Sandbox: " --layout=reverse)

if [[ -z "$APP" ]]; then
    exit 0
fi

if grep -q "Exec=firejail" "$LOCAL_APPS_DIR/$APP" 2>/dev/null; then
    echo "$APP is already sandboxed in $LOCAL_APPS_DIR"
else
    cp "$APPS_DIR/$APP" "$LOCAL_APPS_DIR/$APP"
    sed -i '0,/^Exec=/s/^Exec=/Exec=firejail /' "$LOCAL_APPS_DIR/$APP"
    echo "Sandboxed $APP!"
fi
sleep 3
