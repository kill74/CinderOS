#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

if ! command -v reflector >/dev/null 2>&1; then
  echo "reflector is not installed." >&2
  exit 1
fi

reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
pacman -Syy

echo "CinderOS mirrorlist refreshed."

