#!/usr/bin/env bash
set -euo pipefail

profile_file="/etc/profile.d/cinder-hardware.sh"
environment_file="/etc/environment.d/90-cinderos-hardware.conf"

if [[ "${1:-}" == "--user" ]]; then
  environment_file="${HOME}/.config/cinderos/hardware.conf"
  profile_file="${HOME}/.config/cinderos/hardware.env"
  mkdir -p "$(dirname "$profile_file")"
elif [[ "${EUID}" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

hardware="$({ lspci 2>/dev/null || true; } | tr '[:upper:]' '[:lower:]')"

has_amd=0
has_intel=0
has_nvidia=0

if grep -Eq 'vga|3d|display' <<<"$hardware"; then
  grep -Eq 'amd|advanced micro devices|ati' <<<"$hardware" && has_amd=1
  grep -Eq 'intel' <<<"$hardware" && has_intel=1
  grep -Eq 'nvidia' <<<"$hardware" && has_nvidia=1
fi

{
  echo "# Generated by cinder-hardware-setup. Safe to regenerate."
  echo "MOZ_ENABLE_WAYLAND=1"
  echo "QT_QPA_PLATFORM=wayland"
  echo "CLUTTER_BACKEND=wayland"
  echo "SDL_VIDEODRIVER=wayland"
  echo "STEAM_FORCE_DESKTOPUI_SCALING=1"

  if [[ "$has_amd" -eq 1 ]]; then
    echo "RADV_PERFTEST=aco"
    echo "AMD_VULKAN_ICD=RADV"
  fi

  if [[ "$has_nvidia" -eq 1 ]]; then
    echo "__GLX_VENDOR_LIBRARY_NAME=nvidia"
    echo "GBM_BACKEND=nvidia-drm"
  fi

  if [[ "$has_intel" -eq 1 && "$has_nvidia" -eq 0 ]]; then
    echo "LIBVA_DRIVER_NAME=iHD"
  fi
} >"$environment_file"

{
  echo "# Generated by cinder-hardware-setup. Safe to regenerate."
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    printf 'export %s\n' "$line"
  done <"$environment_file"
} >"$profile_file"

if [[ "$has_nvidia" -eq 1 && -d /etc/modprobe.d ]]; then
  printf 'options nvidia_drm modeset=1 fbdev=1\n' >/etc/modprobe.d/nvidia.conf
fi

echo "CinderOS hardware setup complete."
echo "AMD GPU detected: $has_amd"
echo "Intel GPU detected: $has_intel"
echo "NVIDIA GPU detected: $has_nvidia"
echo "Environment file: $environment_file"
