enable NetworkManager.service
enable systemd-resolved.service
enable ufw.service
enable apparmor.service
enable upower.service
enable seatd.service
enable greetd.service
enable systemd-timesyncd.service
enable power-profiles-daemon.service
enable switcheroo-control.service
enable earlyoom.service
enable cinder-hardware-setup.service

disable bluetooth.service
disable docker.service
disable cups.service
disable fwupd.service
disable systemd-oomd.service
disable cinder-snapshot-setup.service
disable sshd.service
disable fail2ban.service
disable usbguard.service
disable clamav-daemon.service
disable clamav-freshclam.service
disable auditd.service
disable snapper-timeline.timer
disable snapper-cleanup.timer
disable snapper-boot.timer
disable grub-btrfsd.service
disable btrfs-scrub@-.timer
disable btrfsmaintenance-refresh.path
